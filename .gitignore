anya-ui/approvals.json
anya-ui/current.txt

# --- heavy local artifacts: weights, adapters, generated data, logs ---
models/
lora/
logs/
dataset/*.jsonl
*.gguf

# --- third-party helper binaries downloaded on demand (cloudflared tunnel) ---
tools/cloudflared/

# --- python ---
__pycache__/
**/__pycache__/
*.pyc

# --- editors / OS ---
.vscode/
Thumbs.db
desktop.ini
.DS_Store
